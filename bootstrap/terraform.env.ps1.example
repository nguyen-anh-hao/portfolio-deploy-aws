# Terraform credentials — generated by bootstrap\create-terraform-iam.ps1
# ⚠️  DO NOT COMMIT THIS FILE — already in .gitignore
#
# Load vào shell hiện tại:
#   . .\bootstrap\terraform.env.ps1

$env:AWS_ACCESS_KEY_ID     = "REPLACE_AFTER_RUNNING_create-terraform-iam.ps1"
$env:AWS_SECRET_ACCESS_KEY = "REPLACE_AFTER_RUNNING_create-terraform-iam.ps1"
$env:AWS_DEFAULT_REGION    = "ap-southeast-1"
